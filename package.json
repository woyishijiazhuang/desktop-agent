{
  "name": "desktop-agent",
  "version": "1.2.0",
  "description": "桌面助手：基于 Electron 与 Vue 的桌面 AI 助手应用",
  "homepage": "https://github.com/woyishijiazhuang/desktop-agent",
  "author": "woyishijiazhuang",
  "main": "./out/main/index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "oxfmt",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/patch-electron-plist.mjs && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ricky0123/vad-web": "^0.0.30",
    "adm-zip": "^0.6.0",
    "electron-ipc-service": "^0.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "onnxruntime-web": "^1.29.0",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.75",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@thednp/dommatrix": "^3.1.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.19.1",
    "@types/picomatch": "^4.0.3",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "echarts": "^6.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.6",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markstream-vue": "1.0.9",
    "mdize": "^0.2.0",
    "naive-ui": "^2.44.1",
    "oxfmt": "^0.67.0",
    "pinia": "^3.0.4",
    "stream-diffs": "0.0.2",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.0",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.1.6"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037"
}
